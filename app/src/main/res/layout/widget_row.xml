<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/wr_emoji"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/wr_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="#22302D"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/wr_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/w_pill"
        android:paddingStart="9dp"
        android:paddingTop="2dp"
        android:paddingEnd="9dp"
        android:paddingBottom="2dp"
        android:textColor="#5E8C83"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wr_tick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:text="✓"
        android:textColor="#4E9A78"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>